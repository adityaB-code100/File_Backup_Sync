# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/cloud_storage_db

# Django Secret Key (Generate a secure secret key for production)
SECRET_KEY=django-insecure-change-this-in-production-secret-key

# JWT Signing Key (Must be a separate secret from SECRET_KEY)
JWT_SIGNING_KEY=change-this-jwt-signing-key-in-production-super-secret

# Master Key Encryption Key (KEK) for Envelope Encryption
# 32-byte (256-bit) base64 encoded key (Generate using: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())")
FILE_ENCRYPTION_KEK=YOUR_BASE64_ENCODED_32_BYTE_KEK_HERE

# Server Configuration
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Location
STORAGE_ROOT=./file_storage
