# ==============================================================================
# VaultCloud Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root AND in `backend/.env`
# Replace all placeholder values with your environment configuration.
# DO NOT COMMIT LIVE PASSWORDS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# MongoDB Connection String (Atlas URI or local standalone instance)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cloud_storage_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/cloud_storage_db

# Django Secret Key (Generate a secure secret key for production)
SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-for-development

# JWT Signing Key (Keep separate from SECRET_KEY in production)
JWT_SIGNING_KEY=replace-with-a-random-jwt-signing-key

# Master Key Encryption Key (KEK) for Envelope Encryption (AES-256-GCM)
# Generate a fresh 32-byte (256-bit) base64-encoded key via:
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FILE_ENCRYPTION_KEK=YOUR_BASE64_ENCODED_32_BYTE_KEK_HERE

# Development Mode (True / False)
DEBUG=True

# Network Host Access
ALLOWED_HOSTS=localhost,127.0.0.1

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary Encrypted Blob Storage Location (absolute or relative to backend directory)
STORAGE_ROOT=./file_storage

# Secondary Encrypted Backup Root (separate physical drive or path)
# Default on Windows: D:\VaultCloudBackup
SECONDARY_BACKUP_ROOT=D:\VaultCloudBackup
